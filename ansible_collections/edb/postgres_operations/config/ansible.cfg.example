# Example Ansible configuration for running collection playbooks.
# Copy to project root as ansible.cfg, or use -e to pass inventory.
#
# When running from project root (EDB_Testing):
#   ansible.cfg at project root could set:
#   inventory = ansible_collections/edb/postgres_operations/inventory/example-multi-datacenter.yml
#   collections_paths = ./ansible_collections:~/.ansible/collections:/usr/share/ansible/collections

[defaults]
collections_paths = ./ansible_collections:~/.ansible/collections:/usr/share/ansible/collections
inventory = ansible_collections/edb/postgres_operations/inventory/example-multi-datacenter.yml
stdout_callback = yaml
bin_ansible_callbacks = true
gathering = explicit
host_key_checking = false
retry_files_enabled = false
deprecation_warnings = false
command_warnings = false

[inventory]
enable_plugins = yaml, ini, auto

[privilege_escalation]
become = false

[ssh_connection]
pipelining = true
